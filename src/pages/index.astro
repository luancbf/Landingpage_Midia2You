---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Inicio from "../components/sections/Inicio.astro";
import Sobre from "../components/sections/Sobre.astro";
import Planos from "../components/sections/Planos.astro";
import Realtime from "../components/sections/Realtime.astro";
import Pack from "../components/sections/Pack.astro";
import Extra from "../components/sections/Extra.astro";
import Portifolio from "../components/sections/Portifolio.astro";
---

<Layout>
	<Header />

	<main>
		<Inicio />
		<Sobre />
		<Planos />
		<Realtime />
		<Pack />
		<Extra />
		<Portifolio />
	</main>

	<Footer />
</Layout>

<script>
	function initSwipeSlider({ slideSelector, radioName }: { slideSelector: string; radioName: string }) {
		let startX = 0;
		let endX = 0;

		const radios = document.querySelectorAll<HTMLInputElement>(`input[name="${radioName}"]`);
		const slides = document.querySelector(slideSelector);

		if (!slides || radios.length === 0) return;

		slides.addEventListener("touchstart", (event) => {
			startX = (event as TouchEvent).touches[0].clientX;
		});

		slides.addEventListener("touchend", (event) => {
			endX = (event as TouchEvent).changedTouches[0].clientX;
			handleSwipe();
		});

		function handleSwipe() {
			const threshold = 50;
			let checkedIndex = Array.from(radios).findIndex((radio) => radio.checked);

			if (startX - endX > threshold && checkedIndex < radios.length - 1) {
				radios[checkedIndex + 1].checked = true;
			} else if (endX - startX > threshold && checkedIndex > 0) {
				radios[checkedIndex - 1].checked = true;
			}
		}
	}

	initSwipeSlider({
		slideSelector: ".slides-story",
		radioName: "radio-btn-story",
	});

	initSwipeSlider({
		slideSelector: ".slides-planos",
		radioName: "radio-btn",
	});

	initSwipeSlider({
		slideSelector: ".slides-reels",
		radioName: "radio-btn-reels",
	});
</script>

<script>
	var modal = document.getElementById("videoModal") as HTMLElement;
	var iframe = document.getElementById("videoIframe") as HTMLIFrameElement;
	var photos = document.querySelectorAll(".foto-player, .foto-player-reels, .foto-player-story");
	var closeBtn = document.getElementsByClassName("close-player")[0] as HTMLElement;

	photos.forEach(function (photo) {
		(photo as HTMLElement).onclick = function () {
			var videoId = photo.getAttribute("data-video-id");
			iframe.src =
				"https://player.vimeo.com/video/" +
				videoId +
				"?autoplay=1&title=0&byline=0&portrait=0&badge=0&autopause=0&player_id=0&app_id=58479";
			modal.style.display = "block";
		};
	});

	closeBtn.onclick = function () {
		modal.style.display = "none";
		iframe.src = "";
	};
</script>

<script>
	document.addEventListener("click", function (event) {
		const target = event.target as HTMLElement;
		if (target.classList.contains("img-static")) {
			const modal = document.getElementById("modal") as HTMLElement;
			const modalImg = document.getElementById("modalImage") as HTMLImageElement;
			modal.style.display = "flex";
			modalImg.src = (target as HTMLImageElement).src;
		}
	});

	const closeModalBtn = document.getElementById("closeModal");
	if (closeModalBtn) {
		closeModalBtn.onclick = function () {
			(document.getElementById("modal") as HTMLElement).style.display = "none";
		};
	}

	window.onclick = function (event) {
		if ((event.target as HTMLElement).id === "modal") {
			(document.getElementById("modal") as HTMLElement).style.display = "none";
		}
	};
</script>

<script>
	const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	// Scroll-reveal: cada seção com a classe "reveal" ganha fade + slide-up na primeira
	// vez que entra na viewport.
	const revealTargets = document.querySelectorAll<HTMLElement>(".reveal");
	if (prefersReducedMotion || !("IntersectionObserver" in window)) {
		revealTargets.forEach((el) => el.classList.add("is-visible"));
	} else {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12, rootMargin: "0px 0px -80px 0px" },
		);
		revealTargets.forEach((el) => revealObserver.observe(el));
	}

	// Parallax leve: elementos com data-parallax="fator" recebem um deslocamento suave conforme
	// a página rola, via as custom properties --parallax-y/--parallax-x (lidas pelas classes
	// translate-y-(--parallax-y,0px) / translate-x-(--parallax-x,0px) já aplicadas nesses elementos).
	// data-parallax-axis="x" faz o elemento deslocar na horizontal em vez da vertical.
	if (!prefersReducedMotion) {
		const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]")).map((el) => ({
			el,
			factor: parseFloat(el.dataset.parallax || "0"),
			axis: el.dataset.parallaxAxis === "x" ? "x" : "y",
		}));

		let ticking = false;
		function updateParallax() {
			const viewportCenter = window.scrollY + window.innerHeight / 2;
			for (const { el, factor, axis } of parallaxEls) {
				const rect = el.getBoundingClientRect();
				const elCenter = rect.top + window.scrollY + rect.height / 2;
				const delta = (viewportCenter - elCenter) * factor;
				el.style.setProperty(axis === "x" ? "--parallax-x" : "--parallax-y", `${delta}px`);
			}
			ticking = false;
		}
		function onScrollOrResize() {
			if (!ticking) {
				requestAnimationFrame(updateParallax);
				ticking = true;
			}
		}
		updateParallax();
		window.addEventListener("scroll", onScrollOrResize, { passive: true });
		window.addEventListener("resize", onScrollOrResize);

		// A chamada acima pode rodar antes das imagens (sem width/height) terminarem de
		// carregar, calculando a posição com o tamanho errado — daí o elemento nascer
		// deslocado até o primeiro scroll recalcular certo. Recalcula de novo assim que
		// tudo (imagens, fontes) estiver pronto, sem precisar de interação do usuário.
		window.addEventListener("load", updateParallax);
		if (document.fonts && document.fonts.ready) {
			document.fonts.ready.then(updateParallax);
		}
		for (const { el } of parallaxEls) {
			if (el instanceof HTMLImageElement && !el.complete) {
				el.addEventListener("load", updateParallax, { once: true });
			}
		}
	}

	// Seta de "arraste para baixo": rola uma tela ao clicar, e some suavemente assim que
	// o visitante já começou a rolar (só faz sentido enquanto o hero está no topo).
	const scrollHint = document.getElementById("scroll-hint");
	if (scrollHint) {
		scrollHint.addEventListener("click", () => {
			window.scrollTo({ top: window.innerHeight, behavior: prefersReducedMotion ? "auto" : "smooth" });
		});

		let hintTicking = false;
		function updateScrollHint() {
			const fade = Math.max(0, 1 - window.scrollY / (window.innerHeight * 0.5));
			scrollHint!.style.opacity = String(fade);
			scrollHint!.style.pointerEvents = fade < 0.05 ? "none" : "auto";
			hintTicking = false;
		}
		window.addEventListener(
			"scroll",
			() => {
				if (!hintTicking) {
					requestAnimationFrame(updateScrollHint);
					hintTicking = true;
				}
			},
			{ passive: true },
		);
		updateScrollHint();
	}
</script>
