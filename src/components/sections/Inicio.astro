---
import BtnPadrao from "../BtnPadrao.astro";
---

<section
	id="inicio"
	class="animate-hero relative w-full min-h-screen-safe flex flex-wrap-reverse content-center items-center justify-center pt-24 pb-16 mx-8 gap-20 mobile:pt-20 mobile:pb-10 mobile:mx-0 mobile:gap-2.5 tablet-sm:mx-0 tablet-sm:gap-8 carousel:mx-0"
>
	<div
		class="w-152 flex flex-col gap-8 mobile:w-[85%] mobile:items-center tablet-sm:w-[75%] tablet-sm:gap-16 tablet-sm:items-center"
	>
		<h1 class="text-brand-2 font-montserrat text-[1.7rem] font-normal whitespace-pre-line mobile:text-[1rem]">
			<span class="font-semibold">Sem tempo</span> para gerenciar suas <span class="font-semibold">redes, criar</span> conteúdos
			e atender seus <span class="font-semibold">clientes?<br />Deixe que a gente cuida disso para você!</span>
		</h1>
		<div class="flex gap-10 mobile:w-[70%] mobile:justify-center mobile:flex-col mobile:gap-5 tablet-sm:w-[50%] tablet-sm:justify-center tablet-sm:flex-col tablet-sm:gap-5">
			<BtnPadrao href="#planos">Nossos serviços</BtnPadrao>
			<BtnPadrao href="#portifolio">Nosso portifólio</BtnPadrao>
		</div>
	</div>
	<div class="w-140 mobile:w-[80%] tablet-sm:w-[60%]">
		<img
			class="w-full translate-y-(--parallax-y,0px)"
			src="/assets/img/logom2y-01.png"
			alt="Logo da Midia2You"
			data-parallax="0.12"
		/>
	</div>

	<button
		type="button"
		id="scroll-hint"
		aria-label="Rolar para baixo"
		class="scroll-hint absolute bottom-8 left-1/2 -translate-x-1/2 text-brand-2 cursor-pointer animate-scroll-hint transition-opacity duration-500 hover:opacity-100 mobile:bottom-5"
	>
		<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
			<path d="M12 4v15" />
			<path d="M5.5 13 12 19.5 18.5 13" />
		</svg>
	</button>
</section>
