---
---

<header
	id="site-header"
	class="w-screen h-24 flex justify-between items-center bg-brand-1 fixed z-5 transition-shadow duration-300 [&.is-scrolled]:shadow-[0_4px_24px_rgba(0,0,0,0.12)] mobile:h-16 tablet-sm:h-20"
>
	<div class="logo w-[9.4rem] mx-12 mobile:w-16 mobile:m-7.5 tablet-sm:w-24 tablet-portrait:w-32">
		<img class="w-full" src="/assets/img/logom2y-02.png" alt="Logo da Midia2You" />
	</div>
	<nav class="nav mx-8">
		<ul
			class="list-none flex
			mobile:h-auto mobile:flex mobile:items-center mobile:flex-col mobile:absolute mobile:top-16 mobile:left-0 mobile:right-0 mobile:bg-brand-1 mobile:pt-2.5 mobile:px-0 mobile:pb-5 mobile:gap-1.25 mobile:opacity-0 mobile:-translate-y-2 mobile:pointer-events-none mobile:transition-all mobile:duration-300 mobile:[&.active]:opacity-100 mobile:[&.active]:translate-y-0 mobile:[&.active]:pointer-events-auto
			tablet-sm:h-auto tablet-sm:flex tablet-sm:items-center tablet-sm:flex-col tablet-sm:absolute tablet-sm:top-20 tablet-sm:left-0 tablet-sm:right-0 tablet-sm:bg-brand-1 tablet-sm:pt-2.5 tablet-sm:px-0 tablet-sm:pb-5 tablet-sm:gap-1.25 tablet-sm:opacity-0 tablet-sm:-translate-y-2 tablet-sm:pointer-events-none tablet-sm:transition-all tablet-sm:duration-300 tablet-sm:[&.active]:opacity-100 tablet-sm:[&.active]:translate-y-0 tablet-sm:[&.active]:pointer-events-auto
			tablet-portrait:h-auto tablet-portrait:flex tablet-portrait:items-center tablet-portrait:flex-col tablet-portrait:absolute tablet-portrait:top-20 tablet-portrait:left-0 tablet-portrait:right-0 tablet-portrait:bg-brand-1 tablet-portrait:pt-2.5 tablet-portrait:px-0 tablet-portrait:pb-5 tablet-portrait:gap-1.25 tablet-portrait:opacity-0 tablet-portrait:-translate-y-2 tablet-portrait:pointer-events-none tablet-portrait:transition-all tablet-portrait:duration-300 tablet-portrait:[&.active]:opacity-100 tablet-portrait:[&.active]:translate-y-0 tablet-portrait:[&.active]:pointer-events-auto"
		>
			<li
				class="mx-6 mobile:opacity-0 mobile:-translate-y-1 mobile:transition-all mobile:duration-300 mobile:in-[.active]:opacity-100 mobile:in-[.active]:translate-y-0"
			>
				<a
					class="relative font-montserrat text-[1.2rem] font-semibold text-brand-2 no-underline transition-opacity duration-300 hover:opacity-70 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-brand-2 after:transition-all after:duration-300 hover:after:w-full mobile:text-[1rem] tablet-sm:text-[1.5rem] tablet-portrait:text-[1.5rem]"
					href="#inicio">Início</a
				>
			</li>
			<li
				class="mx-6 mobile:opacity-0 mobile:-translate-y-1 mobile:transition-all mobile:duration-300 mobile:delay-75 mobile:in-[.active]:opacity-100 mobile:in-[.active]:translate-y-0"
			>
				<a
					class="relative font-montserrat text-[1.2rem] font-semibold text-brand-2 no-underline transition-opacity duration-300 hover:opacity-70 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-brand-2 after:transition-all after:duration-300 hover:after:w-full mobile:text-[1rem] tablet-sm:text-[1.5rem] tablet-portrait:text-[1.5rem]"
					href="#planos">Nossos planos</a
				>
			</li>
			<li
				class="mx-6 mobile:opacity-0 mobile:-translate-y-1 mobile:transition-all mobile:duration-300 mobile:delay-150 mobile:in-[.active]:opacity-100 mobile:in-[.active]:translate-y-0"
			>
				<a
					class="relative font-montserrat text-[1.2rem] font-semibold text-brand-2 no-underline transition-opacity duration-300 hover:opacity-70 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-brand-2 after:transition-all after:duration-300 hover:after:w-full mobile:text-[1rem] tablet-sm:text-[1.5rem] tablet-portrait:text-[1.5rem]"
					href="#realtime">Real time</a
				>
			</li>
			<li
				class="mx-6 mobile:opacity-0 mobile:-translate-y-1 mobile:transition-all mobile:duration-300 mobile:delay-200 mobile:in-[.active]:opacity-100 mobile:in-[.active]:translate-y-0"
			>
				<a
					class="relative font-montserrat text-[1.2rem] font-semibold text-brand-2 no-underline transition-opacity duration-300 hover:opacity-70 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-brand-2 after:transition-all after:duration-300 hover:after:w-full mobile:text-[1rem] tablet-sm:text-[1.5rem] tablet-portrait:text-[1.5rem]"
					href="#pack">Pack de figurinhas</a
				>
			</li>
			<li
				class="mx-6 mobile:opacity-0 mobile:-translate-y-1 mobile:transition-all mobile:duration-300 mobile:delay-300 mobile:in-[.active]:opacity-100 mobile:in-[.active]:translate-y-0"
			>
				<a
					class="relative font-montserrat text-[1.2rem] font-semibold text-brand-2 no-underline transition-opacity duration-300 hover:opacity-70 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-0 after:bg-brand-2 after:transition-all after:duration-300 hover:after:w-full mobile:text-[1rem] tablet-sm:text-[1.5rem] tablet-portrait:text-[1.5rem]"
					href="#portifolio">Portifólio</a
				>
			</li>
		</ul>
	</nav>
	<button
		type="button"
		id="hamburger"
		aria-label="Abrir menu"
		aria-expanded="false"
		class="hidden relative mobile:block mobile:w-7 mobile:h-5 mobile:mr-5 mobile:cursor-pointer tablet-sm:block tablet-sm:w-9 tablet-sm:h-6 tablet-sm:mr-7.5 tablet-portrait:block tablet-portrait:w-10 tablet-portrait:h-7 tablet-portrait:mr-12"
	>
		<span
			class="hamburger-bar absolute inset-x-0 top-0 h-0.5 bg-brand-2 rounded-full transition-all duration-300 in-[.active]:top-1/2 in-[.active]:-translate-y-1/2 in-[.active]:rotate-45"
		></span>
		<span
			class="hamburger-bar absolute inset-x-0 top-1/2 -translate-y-1/2 h-0.5 bg-brand-2 rounded-full transition-all duration-300 in-[.active]:opacity-0 in-[.active]:scale-x-0"
		></span>
		<span
			class="hamburger-bar absolute inset-x-0 bottom-0 h-0.5 bg-brand-2 rounded-full transition-all duration-300 in-[.active]:bottom-1/2 in-[.active]:translate-y-1/2 in-[.active]:-rotate-45"
		></span>
	</button>
</header>

<script>
	(function () {
		const hamburger = document.getElementById("hamburger");
		const nav = document.querySelector(".nav ul");

		if (hamburger && nav) {
			hamburger.addEventListener("click", function () {
				const isActive = nav.classList.toggle("active");
				hamburger.classList.toggle("active", isActive);
				hamburger.setAttribute("aria-expanded", String(isActive));
				hamburger.setAttribute("aria-label", isActive ? "Fechar menu" : "Abrir menu");
			});
		}

		const header = document.getElementById("site-header");
		if (header) {
			const onScroll = () => {
				header.classList.toggle("is-scrolled", window.scrollY > 12);
			};
			onScroll();
			window.addEventListener("scroll", onScroll, { passive: true });
		}
	})();
</script>
